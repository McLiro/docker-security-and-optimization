FROM ubuntu

WORKDIR /usr/src/app

EXPOSE 5001

COPY code/example-frontend/package*.json ./

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN useradd -m appuser && \
    apt-get update && \
    apt install -y curl && \
    curl -sL https://deb.nodesource.com/setup_16.x | bash && \
    apt install -y nodejs && \
    npm install && \
    npm run build && \
    rm -rf src && \
    rm -rf node_modules && \
    apt-get purge -y --auto-remove curl && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g serve

USER appuser

CMD ["serve", "-s", "-l", "5001", "build"]
